# Variables del frontend (copia a .env en local)
# OJO: todo lo VITE_* termina publico en el bundle — nunca secretos aqui.

# URL del API
VITE_API_URL=http://localhost:8011

# Base del sitio. Solo necesario si despliegas en dominio propio/Render.
# GitHub Pages usa /francisco-brisa/ por defecto (no hace falta definirla).
# VITE_BASE=/
